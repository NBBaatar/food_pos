# ---- Database ----
# Төсөл доторх dev кластер (port 5433). Өөрийн Postgres руу шилжихдээ энэ мөрийг соль.
DATABASE_URL="postgresql://postgres@localhost:5433/food_pos"

# ---- API ----
PORT=4000
NODE_ENV=development
APP_TIMEZONE="Asia/Ulaanbaatar"
# Бизнес өдрийн эхлэл (шөнийн хоол өмнөх өдөртөө хамаарахын тулд)
DAY_START_HOUR=4
# 32+ тэмдэгт санамсаргүй утга: openssl rand -hex 32
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# Кiosk/уншигчийн төхөөрөмжийн анхдагч түлхүүр (seed-д ашиглагдана)
SEED_DEVICE_KEY="kiosk-dev-key-change-me"

# ---- Web (Vite dev server) ----
WEB_ORIGIN="http://localhost:5173"
VITE_API_BASE="/api/v1"
