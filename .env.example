# ---- Database (Homebrew PostgreSQL) ----
# Нэг удаа: brew services start postgresql@17 && createdb food_pos
# Нууц үгээ URL-д оруулж болно: postgresql://USER:PASSWORD@localhost:5432/food_pos
# Эсвэл PGPASSWORD орчны хувьсагчаар өгнө (доор).
DATABASE_URL="postgresql://localhost:5432/food_pos"
# PGPASSWORD="your-postgres-password"

# ---- API ----
PORT=4000
NODE_ENV=development
APP_TIMEZONE="Asia/Ulaanbaatar"
# Бизнес өдрийн эхлэл (шөнийн хоол өмнөх өдөртөө хамаарахын тулд)
DAY_START_HOUR=4
# 32+ тэмдэгт санамсаргүй утга: openssl rand -hex 32
JWT_SECRET="dev-only-secret-change-me-0123456789abcdef"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# Кiosk/уншигчийн төхөөрөмжийн анхдагч түлхүүр (seed-д ашиглагдана)
SEED_DEVICE_KEY="kiosk-dev-key-change-me"

# Proxy (nginx/cloudflare) ард ажиллаж байгаа бол 1 гэж тавина — IP-г X-Forwarded-For-оос уншина
TRUST_PROXY=""

# ---- Web (Vite dev server) ----
WEB_ORIGIN="http://localhost:5173"
VITE_API_BASE="/api/v1"
