generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CardStatus {
  ACTIVE
  BLOCKED
  LOST
}

enum PeriodCode {
  BREAKFAST
  LUNCH
  DINNER
  NIGHT
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
}

enum ScanDecision {
  ACCEPTED
  ALREADY_SCANNED
  UNKNOWN_CARD
  BLOCKED_CARD
  INACTIVE_USER
  OUT_OF_WINDOW
  NO_ACTIVE_CARD
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]

  @@map("departments")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  employeeNo         String     @unique @map("employee_no")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  email              String     @unique
  phone              String?
  passwordHash       String     @map("password_hash")
  role               Role       @default(USER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  departmentId       String?    @db.Uuid @map("department_id")
  department         Department? @relation(fields: [departmentId], references: [id])
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  assignments  CardAssignment[]
  blockedCards Card[]           @relation("CardBlocker")
  scanEvents   ScanEvent[]
  meals        MealRecord[]
  refreshTokens RefreshToken[]
  audits       AuditLog[]

  @@index([departmentId])
  @@map("users")
}

model Card {
  id          String     @id @default(uuid()) @db.Uuid
  uid         String     @unique
  label       String?
  status      CardStatus @default(ACTIVE)
  issuedAt    DateTime   @default(now()) @map("issued_at")
  blockedAt   DateTime?  @map("blocked_at")
  blockedById String?    @db.Uuid @map("blocked_by_id")
  blockedBy   User?      @relation("CardBlocker", fields: [blockedById], references: [id])
  blockReason String?    @map("block_reason")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  assignments CardAssignment[]
  scanEvents  ScanEvent[]
  meals       MealRecord[]

  @@map("cards")
}

model CardAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  cardId       String    @db.Uuid @map("card_id")
  card         Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt   DateTime  @default(now()) @map("assigned_at")
  releasedAt   DateTime? @map("released_at")
  assignedById String?   @db.Uuid @map("assigned_by_id")

  @@index([cardId])
  @@index([userId])
  @@map("card_assignments")
}

model MealPeriod {
  id              String     @id @default(uuid()) @db.Uuid
  code            PeriodCode @unique
  name            String
  startTime       String     @map("start_time")
  endTime         String     @map("end_time")
  crossesMidnight Boolean    @default(false) @map("crosses_midnight")
  isActive        Boolean    @default(true) @map("is_active")
  sortOrder       Int        @default(0) @map("sort_order")

  meals MealRecord[]
  scans ScanEvent[]

  @@map("meal_periods")
}

model Device {
  id         String       @id @default(uuid()) @db.Uuid
  code       String       @unique
  name       String
  location   String?
  apiKeyHash String?      @map("api_key_hash")
  status     DeviceStatus @default(ACTIVE)
  lastSeenAt DateTime?    @map("last_seen_at")
  createdAt  DateTime     @default(now()) @map("created_at")

  scans ScanEvent[]

  @@map("devices")
}

model ScanEvent {
  id             BigInt       @id @default(autoincrement())
  idempotencyKey String?      @unique @map("idempotency_key")
  deviceId       String?      @db.Uuid @map("device_id")
  device         Device?      @relation(fields: [deviceId], references: [id])
  cardUid        String       @map("card_uid")
  cardId         String?      @db.Uuid @map("card_id")
  card           Card?        @relation(fields: [cardId], references: [id])
  userId         String?      @db.Uuid @map("user_id")
  user           User?        @relation(fields: [userId], references: [id])
  scannedAt      DateTime     @map("scanned_at") @db.Timestamptz(3)
  receivedAt     DateTime     @default(now()) @map("received_at") @db.Timestamptz(3)
  businessDate   DateTime     @map("business_date") @db.Date
  periodId       String?      @db.Uuid @map("period_id")
  period         MealPeriod?  @relation(fields: [periodId], references: [id])
  decision       ScanDecision
  reason         String?
  clockSkewMs    Int?         @map("clock_skew_ms")
  rawPayload     Json?        @map("raw_payload")
  meal           MealRecord?

  @@index([businessDate, periodId])
  @@index([userId, businessDate])
  @@index([cardUid])
  @@map("scan_events")
}

model MealRecord {
  id           BigInt     @id @default(autoincrement())
  scanEventId  BigInt     @unique @map("scan_event_id")
  scanEvent    ScanEvent  @relation(fields: [scanEventId], references: [id], onDelete: Cascade)
  userId       String     @db.Uuid @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  cardId       String     @db.Uuid @map("card_id")
  card         Card       @relation(fields: [cardId], references: [id])
  periodId     String     @db.Uuid @map("period_id")
  period       MealPeriod @relation(fields: [periodId], references: [id])
  businessDate DateTime   @map("business_date") @db.Date
  scannedAt    DateTime   @map("scanned_at") @db.Timestamptz(3)
  source       String     @default("KIOSK")
  voidedAt     DateTime?  @map("voided_at") @db.Timestamptz(3)
  voidedById   String?    @db.Uuid @map("voided_by_id")
  voidReason   String?    @map("void_reason")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([businessDate])
  @@index([userId, businessDate])
  @@map("meal_records")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ip        String?
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @db.Uuid @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
